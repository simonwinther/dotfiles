{
    "output": ["DVI-D-1", "HDMI-A-1"],
    "position": "top",
    // Bottom layer (waybar's default, and what config.jsonc uses) so the
    // workspaces-slider pill sits above the bar and receives its own clicks.
    // The exclusive zone still keeps windows off the bar.
    "layer": "bottom",
    "height": 41,
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [],
    // Workspaces come from the workspaces-slider pill, which draws its own
    // layer surface over this bar on every output.
    "modules-center": [],
    "modules-right": ["clock"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "",
            "default": ""
        },
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": 5
        }
    },

    "clock": {
        "format": "<span color='#cdd6f4'>{:%H:%M}</span>",
        "tooltip": false
    }
}
