{
  "output": [
    "eDP-1",
    "DP-2",
    "HDMI-A-1"
  ],
  "position": "top",
  "layer": "bottom",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "height": 46,
  "margin-top": 10,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": [
    "group/hardware"
  ],
  "modules-center": [],
  "modules-right": [
    "group/controls",
    "custom/separator",
    "tray"
  ],
  "hyprland/window": {
    "format": "{}",
    "max-length": 35,
    "rewrite": {
      "": "Harsh"
    },
    "separate-outputs": true
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 9
    }
  },
  "custom/voxtype": {
    "exec": "desktopctl dictation-status",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "idle": "",
      "recording": "\udb80\udf6c",
      "transcribing": "\udb81\udd1f"
    },
    "tooltip": true,
    "on-click-right": "desktopctl launch editor ~/.config/dictate/config.env",
    "on-click": "desktopctl launch tui dictate models"
  },
  "tray": {
    "icon-size": 16,
    "icon-theme": "Papirus",
    "spacing": 14,
    "icons": {
      "NordVPN": "nordvpn-tray-black"
    }
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "<span color='#60a5fa'>\udb82\udd54 </span><span color='#f4f4f5'>{:%H:%M | %a %d %b}</span>",
    "format-alt": "{:%Y-%m-%d}"
  },
  "cpu": {
    "format": "<span color='#4ade80' font_family='Noto Sans Mono'>{icon}</span>  <span color='#eab308'>{usage}%</span> <span color='#4ade80'>\udb80\udf5b</span>",
    "interval": 1,
    "format-icons": [
      "\u25b0\u25b1\u25b1\u25b1\u25b1",
      "\u25b0\u25b0\u25b1\u25b1\u25b1",
      "\u25b0\u25b0\u25b0\u25b1\u25b1",
      "\u25b0\u25b0\u25b0\u25b0\u25b1",
      "\u25b0\u25b0\u25b0\u25b0\u25b0"
    ],
    "on-click": "missioncenter"
  },
  "memory": {
    "interval": 3,
    "format": "<span color='#f87171'>\uefc5 </span><span color='#f4f4f5'>{used:.1f}G / {total:.1f}G</span>"
  },
  "custom/weather": {
    "exec": "~/.config/waybar/weather.sh",
    "return-type": "json",
    "interval": 600,
    "format": "{text}"
  },
  "pulseaudio": {
    "format": "<span color='#f87171'>{icon}</span> <span color='#f4f4f5'>{volume}%</span>",
    "format-muted": "<span color='#f87171'>\udb81\udf5f</span> <span color='#f4f4f5'>{volume}%</span>",
    "format-icons": {
      "headphone": "\uf025",
      "hands-free": "\uf025",
      "headset": "\uf025",
      "phone": "\uf095",
      "portable": "\uf095",
      "car": "\uf1b9",
      "default": [
        "\uf026",
        "\uf027",
        "\uf028"
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 10%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 10%-"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "<span color='#f87171'>\uf130</span>",
    "format-source-muted": "<span color='#f87171'>\uf131</span>",
    "on-click": "wpctl set-mute @DEFAULT_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SOURCE@ 5%-"
  },
  "battery": {
    "interval": 10,
    "states": {
      "good": 70,
      "warning": 40,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "\uf0e7 {capacity}%",
    "format-plugged": "\uf240 {capacity}%",
    "format-icons": [
      "\udb80\udc7a",
      "\udb80\udc7c",
      "\udb80\udc7e",
      "\udb80\udc80",
      "\udb80\udc79"
    ]
  },
  "disk": {
    "interval": 30,
    "path": "/home",
    "format": "<span color='#4ade80'>\uf0a0 </span><span color='#f4f4f5'>{free}</span>"
  },
  "group/hardware": {
    "orientation": "horizontal",
    "modules": [
      "custom/weather",
      "cpu",
      "memory",
      "disk"
    ]
  },
  "group/controls": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "pulseaudio#microphone",
      "battery",
      "clock"
    ]
  },
  "custom/separator": {
    "format": "\u2502",
    "tooltip": false
  }
}
