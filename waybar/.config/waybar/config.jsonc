{
  "output": [
    "eDP-1"
  ],
  "position": "top",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "height": 46,
  "margin-top": 10,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": [
    "custom/weather",
    "cpu",
    "memory",
    "disk"
  ],
  "modules-center": [],
  "modules-right": [
    "pulseaudio",
    "pulseaudio#microphone",
    "battery",
    "clock",
    "custom/separator",
    "tray"
  ],
  "custom/separator": {
    "format": "|",
    "tooltip": false
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 35,
    "rewrite": {
      "": "Harsh"
    },
    "separate-outputs": true
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 9,
    }
  },
  "custom/voxtype": {
    "exec": "omarchy-voxtype-status",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "idle": "",
      "recording": "󰍬",
      "transcribing": "󰔟"
    },
    "tooltip": true,
    "on-click-right": "omarchy-voxtype-config",
    "on-click": "omarchy-voxtype-model"
  },
  "tray": {
    "icon-size": 16,
    "icon-theme": "Papirus",
    "spacing": 10
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "<span color='#60a5fa'>󰥔 </span><span color='#f4f4f5'>{:%H:%M | %a %d %b}</span>",
    "format-alt": "{:%Y-%m-%d}"
  },
  "cpu": {
    "format": "<span color='#4ade80'>{icon0}{icon1}{icon2}{icon3}</span> <span color='#eab308'>{usage:>2}%</span> <span color='#4ade80'>󰍛</span>",
    "interval": 1,
    "format-icons": [
      "▁",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ],
    "on-click": "missioncenter"
  },
  "memory": {
    "interval": 3,
    "format": "<span color='#f87171'> </span> <span color='#f4f4f5'>{used:0.1f}G / {total:0.1f}G</span>"
  },
  "custom/weather": {
    "exec": "~/.config/waybar/weather.sh",
    "return-type": "json",
    "interval": 600,
    "format": "{text}"
  },
  "pulseaudio": {
    "format": "<span color='#4ade80'>{icon}  </span><span color='#f4f4f5'>{volume}%</span>",
    "format-muted": "<span color='#f87171'>󰝟</span>",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 10%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 10%-"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "<span color='#f87171'> </span><span color='#f4f4f5'>{volume}%</span>",
    "format-source-muted": "",
    "on-click": "wpctl set-mute @DEFAULT_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SOURCE@ 5%-"
  },
  "battery": {
    "interval": 10,
    "states": {
      "good": 70,
      "warning": 40,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰁹"
    ]
  },
  "disk": {
    "interval": 30,
    "path": "/home",
    "format": "<span color='#4ade80'> </span><span color='#f4f4f5'>{free}</span>"
  }
}
