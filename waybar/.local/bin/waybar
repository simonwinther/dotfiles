#!/usr/bin/env python3
"""Launch the existing Waybar configuration with Omarchy's light/dark colors."""

import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

args = sys.argv[1:]
config_home = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
waybar_home = config_home / "waybar"


def option(short, long):
    for index, arg in enumerate(args):
        if arg in (short, long) and index + 1 < len(args):
            return args[index + 1]
        if arg.startswith(long + "="):
            return arg.split("=", 1)[1]
    return None


def set_option(short, long, value):
    for index, arg in enumerate(args):
        if arg in (short, long) and index + 1 < len(args):
            args[index + 1] = str(value)
            return
        if arg.startswith(long + "="):
            args[index] = long + "=" + str(value)
            return
    args.extend([long, str(value)])


if not any(arg in ("-h", "--help", "-v", "--version") for arg in args):
    source = Path(option("-c", "--config") or waybar_home / "config.jsonc").expanduser()
    owned = [waybar_home / name for name in ("config.jsonc", "config-minimal.jsonc")]
    if source.resolve() in [path.resolve() for path in owned]:
        light = (config_home / "omarchy/current/theme/light.mode").is_file()
        style_arg = option("-s", "--style")
        style = Path(style_arg).expanduser() if style_arg else waybar_home / "style.css"
        text = source.read_text()
        if light:
            # Pango spans in module formats have their own colors, independent of CSS.
            colors = {
                "#f4f4f5": "#4c4f69", "#cdd6f4": "#4c4f69",
                "#60a5fa": "#1e66f5", "#89b4fa": "#1e66f5",
                "#4ade80": "#40a02b", "#eab308": "#df8e1d",
                "#f87171": "#d20f39",
            }
            text = re.sub(r"#[0-9a-fA-F]{6}", lambda m: colors.get(m[0].lower(), m[0]), text)
            for name in ("style.css", "style-minimal.css"):
                if style.resolve() == (waybar_home / name).resolve():
                    style = waybar_home / name.replace(".css", "-light.css")
                    break
        # NordVPN's monochrome tray icon must contrast with the current theme.
        nordvpn_icon = "nordvpn-tray-black" if light else "nordvpn-tray-white"
        text = re.sub(
            r'("NordVPN"\s*:\s*")[^"]*(")',
            lambda match: match[1] + nordvpn_icon + match[2],
            text,
        )
        runtime = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir())
        runtime = runtime / ("waybar-theme-" + str(os.getuid()))
        runtime.mkdir(mode=0o700, parents=True, exist_ok=True)
        target = runtime / source.name
        with tempfile.NamedTemporaryFile(mode="w", dir=runtime, delete=False) as output:
            output.write(text)
        os.replace(output.name, target)
        set_option("-c", "--config", target)
        set_option("-s", "--style", style)

executable = "/usr/bin/waybar"
cache_home = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
compatibility = cache_home / "waybar-electron-fix"
candidate = compatibility / "build/waybar"
version_file = compatibility / "system-package.txt"
if candidate.is_file() and version_file.is_file():
    package = subprocess.run(["pacman", "-Q", "waybar"], capture_output=True, text=True)
    if package.returncode == 0 and package.stdout.strip() == version_file.read_text().strip():
        executable = str(candidate)

# Omarchy redirects launch output to /dev/null. Keep the bar's diagnostics so
# icon registration and renderer failures remain available after a restart.
if not any(arg in ("-h", "--help", "-v", "--version") for arg in args):
    log_dir = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir())
    log_dir = log_dir / ("waybar-theme-" + str(os.getuid()))
    log_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    log_file = log_dir / "waybar.log"
    if log_file.exists() and log_file.stat().st_size > 512 * 1024:
        os.replace(log_file, log_dir / "waybar.previous.log")
    descriptor = os.open(log_file, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    os.dup2(descriptor, 1)
    os.dup2(descriptor, 2)
    if descriptor > 2:
        os.close(descriptor)

os.execv(executable, ["waybar", *args])
