#!/usr/bin/env bash
set -euo pipefail
umask 077

source_root="${XDG_DATA_HOME:-$HOME/.local/share}/dictate"
cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/dictate"
mkdir -p "$cache_root/build" "$cache_root/bin"
exec 9>"$cache_root/build.lock"
flock -x 9

# Cargo's lockfile, build output, and executables stay outside the Stow repo.
cp "$source_root/Cargo.toml" "$cache_root/build/Cargo.toml"
cp "$source_root/dictionary.example.toml" "$cache_root/build/dictionary.example.toml"
cp -R "$source_root/src" "$cache_root/build/"
cp -R "$source_root/tests" "$cache_root/build/"
export CARGO_TARGET_DIR="$cache_root/target"
if [[ "${1:-}" == --check ]]; then
  cargo fmt --manifest-path "$cache_root/build/Cargo.toml" -- --check
  cargo clippy --manifest-path "$cache_root/build/Cargo.toml" --features overlay --all-targets -- -D warnings
  cargo test --manifest-path "$cache_root/build/Cargo.toml" --features overlay --all-targets
fi
cargo build --release --manifest-path "$cache_root/build/Cargo.toml" --features overlay --bins
for executable in dictate dictate-overlay; do
  install -m 755 "$CARGO_TARGET_DIR/release/$executable" "$cache_root/bin/$executable.new"
done
mv -f "$cache_root/bin/dictate-overlay.new" "$cache_root/bin/dictate-overlay"
mv -f "$cache_root/bin/dictate.new" "$cache_root/bin/dictate"
printf 'Rust dictation installed in %s/bin\n' "$cache_root"
