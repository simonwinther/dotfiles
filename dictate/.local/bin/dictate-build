#!/usr/bin/env bash
set -euo pipefail
script="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="$(cd "$(dirname "$script")/../../.." && pwd -P)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../../bin/.local/share/dotfiles/rust-build.sh
source "$repo_root/bin/.local/share/dotfiles/rust-build.sh"
source_root="$(dirname "$(dirname "$script")")/share/dictate"
rust_build_init dictate "$script" "$@"
rust_build_checks --features overlay
rust_build_cargo build --release --features overlay --bins
for executable in dictate dictate-overlay; do
  install -m 755 "$CARGO_TARGET_DIR/release/$executable" "$cache_root/bin/$executable.new"
done
mv -f "$cache_root/bin/dictate-overlay.new" "$cache_root/bin/dictate-overlay"
mv -f "$cache_root/bin/dictate.new" "$cache_root/bin/dictate"
printf 'Rust dictation installed in %s/bin\n' "$cache_root"
