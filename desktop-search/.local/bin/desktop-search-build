#!/usr/bin/env bash
set -euo pipefail
script="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="$(cd "$(dirname "$script")/../../.." && pwd -P)"
# shellcheck source=../../../bin/.local/share/dotfiles/rust-build.sh
source "$repo_root/bin/.local/share/dotfiles/rust-build.sh"
source_root="$repo_root/desktop-search/.local/share/desktop-search"
rust_build_init desktop-search "$script" "$@"
cp "$repo_root/desktop-bar/.local/share/desktop-bar/src/process.rs" "$cache_root/build/src/process.rs"
cp "$repo_root/desktop-bar/.local/share/desktop-bar/src/fuzzy.rs" "$cache_root/build/src/fuzzy.rs"
sed -i 's|../../../../../desktop-bar/.local/share/desktop-bar/src/process.rs|process.rs|' "$cache_root/build/src/main.rs"
sed -i 's|../../../../../desktop-bar/.local/share/desktop-bar/src/fuzzy.rs|fuzzy.rs|' "$cache_root/build/src/main.rs"
# shellcheck disable=SC2119
rust_build_checks
rust_build_cargo build --release --bin desktop-search
rust_build_publish "$CARGO_TARGET_DIR/release/desktop-search" "$cache_root/bin/desktop-search"
printf 'Desktop search installed in %s/bin\n' "$cache_root"
