#!/usr/bin/env bash
set -euo pipefail
script="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="$(cd "$(dirname "$script")/../../.." && pwd -P)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../../bin/.local/share/dotfiles/rust-build.sh
source "$repo_root/bin/.local/share/dotfiles/rust-build.sh"
source_root="$(dirname "$(dirname "$script")")/share/text-picker"
rust_build_init text-picker "$script" "$@"
rust_build_checks
rust_build_cargo build --release --bin text-picker-native
rust_build_publish "$CARGO_TARGET_DIR/release/text-picker-native" "$cache_root/bin/text-picker-native"
printf 'Rust text pickers installed in %s/bin\n' "$cache_root"
