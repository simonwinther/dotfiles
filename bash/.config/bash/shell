# History control
shopt -s histappend
HISTCONTROL=ignoreboth
HISTSIZE=32768
HISTFILESIZE="${HISTSIZE}"

# Autocompletion
if [[ ! -v BASH_COMPLETION_VERSINFO && -f ${BASH_COMPLETION_FILE:-/usr/share/bash-completion/bash_completion} ]]; then
  source ${BASH_COMPLETION_FILE:-/usr/share/bash-completion/bash_completion}
fi

# Ensure command hashing is off for mise
set +h
