{
  "manifest_version": 3,
  "name": "Better Copy",
  "description": "Copy selections and messages as LaTeX or Markdown, preserving equation source.",
  "version": "0.3.1",
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "action": {
    "default_title": "Better Copy",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
