{
  "manifest_version": 3,
  "name": "Project Picker Sync",
  "version": "0.1.1",
  "description": "Keep the desktop project picker up to date while browsing.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "webRequest",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sync project picker"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "api.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
