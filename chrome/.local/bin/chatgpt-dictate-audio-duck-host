#!/bin/sh
set -eu
if command -v dictation-volume-duck-native >/dev/null 2>&1; then
    exec dictation-volume-duck-native --native-host "$@"
fi
binary="${XDG_CACHE_HOME:-$HOME/.cache}/dictation-volume-duck/bin/dictation-volume-duck-native"
if [ ! -x "$binary" ]; then
    printf '%s\n' 'dictation-volume-duck: Run dictation-volume-duck-build to compile the Rust helper.' >&2
    exit 1
fi
exec "$binary" --native-host "$@"
