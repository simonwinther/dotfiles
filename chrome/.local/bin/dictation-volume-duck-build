#!/usr/bin/env bash
set -euo pipefail
umask 077
case "${1:-}" in
  ''|--check) ;;
  *) printf 'Usage: dictation-volume-duck-build [--check]\n' >&2; exit 2 ;;
esac
if (( $# > 1 )); then
  printf 'Usage: dictation-volume-duck-build [--check]\n' >&2
  exit 2
fi
script="$(readlink -f -- "${BASH_SOURCE[0]}")"
source_root="$(dirname "$(dirname "$script")")/share/dictation-volume-duck"
cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/dictation-volume-duck"
mkdir -p "$cache_root/build" "$cache_root/bin"
exec 9>"$cache_root/build.lock"
flock -x 9
# Build artifacts stay in the cache, outside the Stow package.
rm -rf -- "$cache_root/build/src" "$cache_root/build/tests"
cp "$source_root/Cargo.toml" "$cache_root/build/Cargo.toml"
cp "$source_root/Cargo.lock" "$cache_root/build/Cargo.lock"
cp -R "$source_root/src" "$cache_root/build/"
if [[ -d "$source_root/tests" ]]; then
  cp -R "$source_root/tests" "$cache_root/build/"
fi
export CARGO_TARGET_DIR="$cache_root/target"
if [[ "${1:-}" == --check ]]; then
  cargo fmt --manifest-path "$cache_root/build/Cargo.toml" -- --check
  nice -n 10 cargo clippy --locked --manifest-path "$cache_root/build/Cargo.toml" --all-targets -- -D warnings
  nice -n 10 cargo test --locked --manifest-path "$cache_root/build/Cargo.toml" --all-targets
fi
nice -n 10 cargo build --locked --release --manifest-path "$cache_root/build/Cargo.toml" --bin dictation-volume-duck-native
install -m 755 "$CARGO_TARGET_DIR/release/dictation-volume-duck-native" "$cache_root/bin/dictation-volume-duck-native.new"
mv -f "$cache_root/bin/dictation-volume-duck-native.new" "$cache_root/bin/dictation-volume-duck-native"
printf 'Rust audio ducking helper installed in %s/bin\n' "$cache_root"
