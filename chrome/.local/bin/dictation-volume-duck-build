#!/usr/bin/env bash
set -euo pipefail
script="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="$(cd "$(dirname "$script")/../../.." && pwd -P)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../../bin/.local/share/dotfiles/rust-build.sh
source "$repo_root/bin/.local/share/dotfiles/rust-build.sh"
source_root="$(dirname "$(dirname "$script")")/share/dictation-volume-duck"
rust_build_init dictation-volume-duck "$script" "$@"
rust_build_checks
rust_build_cargo build --release --bin dictation-volume-duck-native
rust_build_publish "$CARGO_TARGET_DIR/release/dictation-volume-duck-native" "$cache_root/bin/dictation-volume-duck-native"
printf 'Rust audio ducking helper installed in %s/bin\n' "$cache_root"
