# OpenAI dictation config. 
# OPENAI_API_KEY goes in ~/.config/openai-dictation/secrets.env.


# Recommended high-accuracy model for completed recordings.
OPENAI_MODEL='gpt-transcribe'

# gpt-transcribe supports multiple expected languages and code-switching.
# Comma-separated ISO language codes become repeated languages[] form fields.
OPENAI_LANGUAGES='en,da'
# Legacy fallback for models that accept only the singular language field.
# Do not set this together with OPENAI_LANGUAGES.
OPENAI_LANGUAGE=''
# Optional unstructured context. The API says the prompt should match the
# audio language, so mixed English/Danish vocabulary is supplied as keywords.
OPENAI_PROMPT=''
# Comma-separated literal terms become repeated keywords[] form fields.
OPENAI_KEYWORDS='Djafar,Hyprland,Waybar,Neovim,Omarchy,Ghostty,Walker,Waypaper,tmux,zsh,Arch Linux'

# Low-latency mono WAV recording through PipeWire.
RECORD_RATE=16000
RECORD_CHANNELS=1
RECORD_FORMAT='s16'
RECORD_LATENCY='20ms'
MIN_RECORDING_MS=1000
MAX_RECORDING_MS=300000
SKIP_SILENCE=1
SILENCE_MAX_DB=-50
KEEP_AUDIO=0

# Preprocessing before upload. Pause trimming segments the recording with
# per-frame RMS levels (50 ms frames): blips shorter than 0.15 s (breaths,
# key clicks, hiss spikes) inside a pause are ignored, and every pause
# longer than SILENCE_MIN_PAUSE seconds is cut down to SILENCE_KEEP
# seconds on each side. ffmpeg then encodes the upload as UPLOAD_CODEC.
# Falls back to the raw recording whenever a step fails or the output
# looks broken.
# FFMPEG_PREPROCESS=0 disables it all.
FFMPEG_PREPROCESS=1
TRIM_SILENCE=1
# Per-recording calibration: measures the clip's own speech level and noise
# floor, then puts the trim threshold SILENCE_SPEECH_MARGIN_DB below the
# speech level (never closer than 6 dB to the floor). Smaller margin =
# more aggressive trimming (try 10); raise it if quiet words get clipped.
# If speech and floor are less than 10 dB apart (loud background noise,
# media still playing), trimming is skipped and the debug banner says why.
# SILENCE_THRESHOLD_DB is only used when SILENCE_AUTO_THRESHOLD=0.
SILENCE_AUTO_THRESHOLD=1
SILENCE_SPEECH_MARGIN_DB=12
SILENCE_THRESHOLD_DB=-45

# Only cut real thinking-pauses. Sub-second pauses cost almost no upload
# time, every cut is a splice artifact, and with the auto threshold sitting
# only ~6 dB above this room's noise floor a quiet word inside a pause can
# be cut along with it. Multi-second silences are still trimmed; those are
# what make the model hallucinate.
SILENCE_MIN_PAUSE=1.5

# SILENCE_KEEP=0.25
SILENCE_KEEP=0.35

# Speedup disabled. 1.5x hurt Danish accuracy badly and 1.2x still risked
# it, while shrinking a 45s clip only cut ~0.2s off the API round trip.
SPEEDUP_FACTOR=1.0

# Recordings shorter than this skip preprocessing.
PREPROCESS_MIN_MS=3000
# mp3 uploads are ~4x smaller than wav without touching the audio's time
# structure; the script falls back to the wav whenever the encode fails.
UPLOAD_CODEC=mp3
# Debug banner (hyprctl notify) after each preprocessing run, e.g.
# "27.6s → trim 24.1s (2 pauses) → 24.1s (-13%, ffmpeg 0.14s)". Set 0 to hide.
DEBUG_NOTIFY=1

# Clipboard is always updated. Auto-paste mirrors Super+V universal paste.
# In Ghostty, this falls back to Ctrl+Shift+V so Neovim keeps Ctrl+V.
# Set AUTO_PASTE=0 if you only want the transcript copied.
AUTO_PASTE=1
PASTE_METHOD='hyprctl-super-v'
PASTE_DELAY='0.08'
SHOW_LOADING=1
TRANSCRIBE_OVERLAY_MIN_MS=360
DUCK_VOLUME=1
# 0.1 keeps playback bleed out of the quiet Focusrite mic; at 0.3 it was
# raising the noise floor for both transcription and trim calibration.
VOLUME_DUCK_FACTOR=0.1

# Estimated recording cost shown in the overlay while recording.
# OpenAI pricing checked 2026-07-31: gpt-transcribe $0.0045/min,
# gpt-4o-transcribe $0.006/min, gpt-4o-mini-transcribe $0.003/min.
# USD/DKK checked 2026-05-31 at about 6.4104.
SHOW_COST_ESTIMATE=1
OPENAI_COST_USD_PER_MINUTE='auto'
OPENAI_COST_CURRENCY='DKK'
OPENAI_COST_USD_TO_DKK='6.4104'

NOTIFY=0
CURL_CONNECT_TIMEOUT=10
CURL_MAX_TIME=120
