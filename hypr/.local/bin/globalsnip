#!/usr/bin/env bash
set -euo pipefail

PICKER_CLASS="global.snip"
FOCUS_TIMEOUT_MS=700
FOCUS_POLL_DELAY=0.02
PASTE_DELAY=0.15

need() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'missing: %s\n' "$1" >&2
    exit 127
  }
}

for cmd in fzf hyprctl python3 setsid wl-copy wtype; do
  need "$cmd"
done

active_window_class() {
  hyprctl activewindow -j 2>/dev/null | python3 -c '
import json
import sys

try:
    window = json.load(sys.stdin)
except Exception:
    sys.exit(1)

print(window.get("class") or window.get("initialClass") or "")
'
}

active_window_is_ghostty() {
  local class
  class="$(active_window_class)" || return 1

  case "$class" in
  com.mitchellh.ghostty | ghostty | *Ghostty*)
    return 0
    ;;
  *)
    return 1
    ;;
  esac
}

wait_for_focus_to_leave_picker() {
  local class elapsed_ms
  elapsed_ms=0

  while ((elapsed_ms < FOCUS_TIMEOUT_MS)); do
    class="$(active_window_class 2>/dev/null || true)"
    if [[ -n "$class" && "$class" != "$PICKER_CLASS" ]]; then
      return 0
    fi

    sleep "$FOCUS_POLL_DELAY"
    elapsed_ms=$((elapsed_ms + 20))
  done

  return 1
}

paste_clipboard() {
  if active_window_is_ghostty; then
    wtype -M ctrl -M shift -k v -m shift -m ctrl >/dev/null 2>&1
  else
    wtype -M ctrl -k v -m ctrl >/dev/null 2>&1
  fi
}

copy_focus_and_paste() {
  local text="$1"

  printf '%s' "$text" | wl-copy --trim-newline
  hyprctl dispatch exec "$0 --paste" >/dev/null 2>&1 ||
    setsid -f "$0" --paste </dev/null >/dev/null 2>&1
}

paste_after_picker_closes() {
  sleep "$PASTE_DELAY"

  if [[ "$(active_window_class 2>/dev/null || true)" == "$PICKER_CLASS" ]]; then
    hyprctl dispatch focuswindow previous >/dev/null 2>&1 || true
  fi

  wait_for_focus_to_leave_picker || true
  paste_clipboard
}

if [[ "${1:-}" == "--paste" ]]; then
  paste_after_picker_closes
  exit
fi

choice="$(
  fzf \
    --delimiter=$'\t' \
    --with-nth=1,2 \
    --nth=1,2 \
    --reverse \
    --border=rounded \
    --margin=5% \
    --prompt="Search > " \
    --color=fg:white,fg+:white,bg+:-1 \
    --color=hl:green,hl+:bright-green \
    --color=border:green,prompt:green,pointer:green,marker:green,spinner:green,info:gray \
    --preview-window=right:45%:wrap \
    --preview="cut -f2- <<< {}" \
    --tabstop=2 \
    --separator=' │ ' \
    --no-hscroll <<'EOF'
Agent	Turn this into a short, clear prompt for an AI agent. Include the goal, essential context, constraints, and what the agent should do. Keep it concise and actionable. Do not solve the task yourself.
Agent Short	Turn this into a short, easy-to-read prompt for an AI agent. Capture only the goal, essential context, important constraints, and expected outcome. Assume the agent knows nothing beyond the prompt and should inspect or figure out missing implementation details itself. Avoid unnecessary specifics, long explanations, and step-by-step solutions. Keep it concise enough to quickly read and verify. Do not solve the task yourself.
ImageGen	Use a clean, crisp, publication-quality visual style suitable for professional university lecture slides, academic presentations, scientific posters, and technical reports; keep the image polished, structured, minimal, and easy to understand at a glance; avoid all unnecessary visual and textual noise, including grain, film grain, static, speckles, dithering, paper texture, fuzzy patterns, random particles, halftone effects, compression artifacts, decorative textures, meaningless background details, artificial “AI-generated” texture, excessive icons, arbitrary symbols, floating decorative elements, redundant arrows, unnecessary callouts, visual filler, and clutter; use solid flat colors, sharp edges, clean geometric shapes, consistent line widths, generous whitespace, clear alignment, balanced spacing, and a strong visual hierarchy; use smooth gradients only when they serve a clear purpose; keep the composition calm, spacious, and intentionally designed rather than dense or busy; make all visible text large, sharp, high-contrast, correctly spelled, and easy to read; use only text that is genuinely necessary to explain the content and do not invent generic headings, slogans, captions, labels, acronyms, terminology, numbers, equations, or filler text; avoid garbled text, misspellings, duplicated labels, corrupted characters, meaningless symbols, tiny annotations, decorative microtext, pseudo-technical language, placeholder text, and generic infographic phrases such as “Key Idea,” “Core Concept,” “Insight,” “Important,” or “Takeaway” unless explicitly requested; prefer a few meaningful labels over many small labels and never fill empty space simply to make the image appear more detailed; use a restrained, professional academic color palette with strong contrast and avoid excessive glow, shadows, bevels, lens effects, neon effects, pseudo-3D decoration, exaggerated depth, or unnecessary stylistic embellishments; every visual element should have a clear informational purpose; the final image should resemble a professionally designed vector graphic from a university lecture slide, academic textbook, scientific paper, or technical presentation rather than a decorative, cluttered, or stereotypically AI-generated illustration.
ImageGenShort	Use a clean, crisp, publication-quality visual style suitable for professional university lecture slides, academic presentations, scientific posters, and technical reports; keep the image polished, structured, minimal, and easy to understand at a glance.
Fix	Fix grammar, spelling, and obvious wording mistakes in this text. Keep the original tone, style, and sentence structure as much as possible. Do not rewrite or over polish. Only make changes where something is incorrect, unclear, or unnatural, and prefer minimal edits. Do not use em dashes, en dashes, hyphens as separators, or semicolons. Use simple sentences and standard punctuation only. Do not change any symbols. Keep all symbols exactly as they are, including ' and commas. Do not replace them with other variations.
Concise	Rewrite this to be as concise as possible without losing any meaning.
Explain Concise	Explain this as concise and short, as possible without losing any meaning.
Explain Exact	Rewrite the exact same text you just wrote, without changing its structure, order, or content. The only difference should be that every line is explained in much more depth. Do not assume any prior knowledge. Define and explain all terms, symbols, and concepts as they appear, and go through the text line by line, explaining what each part means and why it is written that way.
Short	Rewrite this to be as concise as possible without losing any meaning.
Formal	Rewrite this in a formal, academic tone.
Explain	Explain this from first principles. Do not assume prior knowledge, and clearly define all terms and concepts before using them.
LLM Summary	Summarize the entire conversation so far so it can be given to another LLM. Include all relevant context, decisions, constraints, preferences, and what has already been tried. Be factual and concise but complete. Do not add commentary, framing phrases, or explanations. Output only the summary text and nothing else.
Help Topic	I do not want the solution yet. I want to understand the topic behind this task. Explain the big picture first. Then define all important terms and symbols. Then explain the core ideas step by step with intuition. Then show how this type of task is usually solved in general. Only at the end, relate it back to this specific exercise.
Study	I do not want the solution yet. I want to understand the topic behind this task. Explain the big picture first. Then define all important terms and symbols. Then explain the core ideas step by step with intuition. Then show how this type of task is usually solved in general. Only at the end, relate it back to this specific exercise. /study
EOF
)" || exit 0

[[ "$choice" == *$'\t'* ]] || exit 0
snippet="${choice#*$'\t'}"

copy_focus_and_paste "$snippet"
