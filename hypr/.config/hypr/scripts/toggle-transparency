#!/bin/bash

set -euo pipefail

state_file="${XDG_RUNTIME_DIR:-/tmp}/hypr-global-opacity-disabled"

set_rule_enabled() {
  local enabled="$1"

  if hyprctl status | rg -q '^configProvider: lua$'; then
    hyprctl eval "require('windows').opaque_rule:set_enabled($enabled)" >/dev/null
  else
    hyprctl keyword 'windowrule[global-opaque]:enable' "$enabled" >/dev/null
  fi
}

set_all_windows_opaque() {
  local value="$1"

  while IFS= read -r address; do
    if hyprctl status | rg -q '^configProvider: lua$'; then
      hyprctl dispatch "hl.dsp.window.set_prop({ window = 'address:$address', prop = 'opaque', value = '$value' })" >/dev/null
    else
      hyprctl dispatch setprop "address:$address" opaque "$value" >/dev/null
    fi
  done < <(hyprctl clients -j | jq -r '.[].address')
}

if [[ -e "$state_file" ]]; then
  set_rule_enabled false
  set_all_windows_opaque unset
  rm -f -- "$state_file"
  notify-send "Transparency enabled globally"
else
  set_rule_enabled true
  set_all_windows_opaque 1
  touch "$state_file"
  notify-send "Transparency disabled globally"
fi
