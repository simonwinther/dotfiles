#!/bin/bash

set -euo pipefail

# Serialize presses so their notifications stay in the same order as the toggles.
umask 077
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/hypr-transparency-${UID}-${HYPRLAND_INSTANCE_SIGNATURE:-default}.lock"
flock 9

# Hyprland owns the state and updates every window in one operation.
if ! mode=$(hyprctl repl "return require('windows').toggle_transparency()" 2>&1); then
  printf 'Could not toggle transparency: %s\n' "$mode" >&2
  exit 1
fi

# hyprctl can return Lua errors without a failing exit status.
case "$mode" in
  enabled|disabled) ;;
  *) printf 'Could not toggle transparency: %s\n' "$mode" >&2; exit 1 ;;
esac

notify-send -a "Transparency" -t 1200 \
  -h string:x-canonical-private-synchronous:global-transparency \
  "Transparency $mode globally" || true
