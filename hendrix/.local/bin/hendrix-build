#!/usr/bin/env bash
set -euo pipefail
script="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="$(cd "$(dirname "$script")/../../.." && pwd -P)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../../bin/.local/share/dotfiles/rust-build.sh
source "$repo_root/bin/.local/share/dotfiles/rust-build.sh"
source_root="$(dirname "$(dirname "$script")")/share/hendrix/ssh"
rust_build_init hendrix "$script" "$@"
# shellcheck disable=SC2119
rust_build_checks
rust_build_cargo build --release --bin hendrix-ssh
rust_build_publish "$CARGO_TARGET_DIR/release/hendrix-ssh" "$cache_root/bin/hendrix-ssh"
printf 'Native Hendrix ssh launcher installed in %s/bin\n' "$cache_root"
