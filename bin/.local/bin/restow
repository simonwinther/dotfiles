#!/usr/bin/env bash
set -euo pipefail
if [[ -e /etc/NIXOS ]]; then
  echo 'Home Manager owns this configuration. Use nixos-rebuild to update it.' >&2
  exit 1
fi
source_file=$(readlink -f -- "${BASH_SOURCE[0]}")
dots=${DESKTOP_DOTFILES:-$(cd -- "$(dirname -- "$source_file")/../../.." && pwd)}
[[ -d $dots/hypr && -d $dots/zsh ]] || { echo 'Set DESKTOP_DOTFILES to the portable dotfiles/ directory.' >&2; exit 1; }
exec python3 "$dots/deploy.py" "$HOME" --apply
