#!/bin/sh
set -eu
if command -v plot-native >/dev/null 2>&1; then
    exec plot-native "$@"
fi
binary="${XDG_CACHE_HOME:-$HOME/.cache}/plot/bin/plot-native"
if [ ! -x "$binary" ]; then
    printf '%s\n' 'plot: Run plot-build to compile the Rust formula plotter.' >&2
    exit 1
fi
exec "$binary" "$@"
