#!/usr/bin/env bash
set -euo pipefail
script="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="$(cd "$(dirname "$script")/../../.." && pwd -P)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../../bin/.local/share/dotfiles/rust-build.sh
source "$repo_root/bin/.local/share/dotfiles/rust-build.sh"
source_root="$(dirname "$(dirname "$script")")/share/plot"
rust_build_init plot "$script" "$@"
rust_build_checks
rust_build_cargo build --release --bin plot-native
rust_build_publish "$CARGO_TARGET_DIR/release/plot-native" "$cache_root/bin/plot-native"
printf 'Rust formula plotter installed in %s/bin\n' "$cache_root"
