#!/usr/bin/env bash
set -euo pipefail

check=false
case "${1:-}" in
  --check) check=true; shift ;;
  "") ;;
  *) printf 'Usage: file-picker-build [--check]\n' >&2; exit 2 ;;
esac
if (( $# )); then
  printf 'Usage: file-picker-build [--check]\n' >&2
  exit 2
fi

source_root="${XDG_DATA_HOME:-$HOME/.local/share}/file-picker"
cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/file-picker"
mkdir -p "$cache_root/build" "$cache_root/bin"

# Keep Build output, compiled artifacts and executables outside the Stow repo.
cp "$source_root/Cargo.toml" "$cache_root/build/Cargo.toml"
cp "$source_root/Cargo.lock" "$cache_root/build/Cargo.lock"
rm -rf -- "$cache_root/build/src" "$cache_root/build/tests"
cp -R "$source_root/src" "$cache_root/build/"
cp -R "$source_root/tests" "$cache_root/build/"
export CARGO_TARGET_DIR="$cache_root/target"
if "$check"; then
  cargo fmt --manifest-path "$cache_root/build/Cargo.toml" --all -- --check
  nice -n 10 cargo clippy --locked --manifest-path "$cache_root/build/Cargo.toml" --all-targets --features drag -- -D warnings
  nice -n 10 cargo test --locked --manifest-path "$cache_root/build/Cargo.toml" --features drag
fi
nice -n 10 cargo build --locked --release --manifest-path "$cache_root/build/Cargo.toml" --bin file-picker-native
nice -n 10 cargo build --locked --release --manifest-path "$cache_root/build/Cargo.toml" --features drag --bin file-picker-drag
install -m 755 "$CARGO_TARGET_DIR/release/file-picker-native" "$cache_root/bin/file-picker-native.new"
install -m 755 "$CARGO_TARGET_DIR/release/file-picker-drag" "$cache_root/bin/file-picker-drag.new"
mv -f "$cache_root/bin/file-picker-drag.new" "$cache_root/bin/file-picker-drag"
mv -f "$cache_root/bin/file-picker-native.new" "$cache_root/bin/file-picker-native"
printf 'Rust file picker installed in %s/bin\n' "$cache_root"
