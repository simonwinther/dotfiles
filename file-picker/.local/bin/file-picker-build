#!/usr/bin/env bash
set -euo pipefail
script="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="$(cd "$(dirname "$script")/../../.." && pwd -P)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../../bin/.local/share/dotfiles/rust-build.sh
source "$repo_root/bin/.local/share/dotfiles/rust-build.sh"
source_root="$(dirname "$(dirname "$script")")/share/file-picker"
rust_build_init file-picker "$script" "$@"
rust_build_checks --features drag
rust_build_cargo build --release --features drag --bins
for binary in file-picker-native file-picker-drag; do
  rust_build_publish "$CARGO_TARGET_DIR/release/$binary" "$cache_root/bin/$binary"
done
printf 'Rust file picker installed in %s/bin\n' "$cache_root"
