#!/bin/sh
set -eu

binary="${XDG_CACHE_HOME:-$HOME/.cache}/file-picker/bin/file-picker-native"
if [ ! -x "$binary" ]; then
    message='Run file-picker-build once to compile the Rust picker.'
    printf '%s\n' "file-picker: $message" >&2
    notify-send -a 'File picker' 'File picker needs a build' "$message" 2>/dev/null || true
    exit 1
fi
export FILE_PICKER_EXECUTABLE="$binary"
exec "$binary" "$@"
