#!/usr/bin/env python3
"""Set up cluster tools, submit jobs, and read Slurm output over SSH."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys


class Error(Exception):
    pass


def shell_join(arguments):
    return " ".join(shlex.quote(str(argument)) for argument in arguments)


def git(*arguments, **kwargs):
    result = subprocess.run(
        ["git"] + list(arguments), cwd=kwargs.get("cwd"),
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True,
    )
    if result.returncode:
        raise Error(result.stderr.strip() or "Run this command inside a Git repository.")
    return result.stdout.strip()


def repo_root():
    return Path(git("rev-parse", "--show-toplevel")).resolve()


def config(root, key):
    result = subprocess.run(
        ["git", "config", "--local", "--get", key], cwd=str(root),
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True,
    )
    return result.stdout.strip() if result.returncode == 0 else None


def identity(url):
    """Compare SSH and HTTPS spellings of the same Git origin."""
    url = url.strip().rstrip("/")
    url = re.sub(r"^[^/@:]+@([^/:]+):", r"\1/", url)
    url = re.sub(r"^[a-zA-Z][a-zA-Z0-9+.-]*://(?:[^/@]+@)?", "", url)
    return re.sub(r"\.git$", "", url).lower()


# Keep the remote side compatible with Hendrix's system Python 3.6.
# Arguments and results are JSON; project paths never become shell source.
REMOTE = r'''
import json, os, re, subprocess, sys

def run(args, cwd=None, env=None):
    p = subprocess.run(args, cwd=cwd, env=env, stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE, universal_newlines=True)
    if p.returncode:
        raise RuntimeError(p.stderr.strip() or "Command failed: " + args[0])
    if p.stderr:
        sys.stderr.write(p.stderr)
    return p.stdout.strip()

def identity(url):
    url = url.strip().rstrip("/")
    url = re.sub(r"^[^/@:]+@([^/:]+):", r"\1/", url)
    url = re.sub(r"^[a-zA-Z][a-zA-Z0-9+.-]*://(?:[^/@]+@)?", "", url)
    return re.sub(r"\.git$", "", url).lower()

def repository(path):
    path = os.path.expanduser(path)
    if not os.path.isabs(path):
        path = os.path.join(os.path.expanduser("~"), path)
    root = run(["git", "rev-parse", "--show-toplevel"], cwd=path)
    return {"path": root,
            "origin": identity(run(["git", "remote", "get-url", "origin"], cwd=root)),
            "commit": run(["git", "rev-parse", "HEAD"], cwd=root),
            "dirty": bool(run(["git", "status", "--porcelain", "--untracked-files=no"], cwd=root))}

def job_info(job):
    text = run(["scontrol", "-o", "show", "job", job])
    fields = list(re.finditer(r"(?:^|\s)([A-Za-z][A-Za-z0-9_]*)=", text))
    return {m.group(1): text[m.end():fields[i + 1].start() if i + 1 < len(fields) else len(text)].strip()
            for i, m in enumerate(fields)}

try:
    action, data = sys.argv[1], json.loads(sys.argv[2])
    if action == "repo":
        answer = repository(data["path"])
    elif action == "job":
        answer = job_info(data["job"])
    elif action == "submit":
        repo = repository(data["path"])
        if identity(repo["origin"]) != identity(data["origin"]):
            raise RuntimeError("The paired checkout has a different Git origin. Run cluster link again.")
        if repo["commit"] != data["commit"]:
            raise RuntimeError("Local and cluster commits differ. Push your local commit and pull it on the cluster first.\n"
                               + "Local: " + data["commit"] + "\nCluster: " + repo["commit"])
        if repo["dirty"]:
            raise RuntimeError("The cluster checkout has uncommitted tracked changes. Resolve them before submitting.")
        workdir = os.path.realpath(os.path.join(repo["path"], data["subdir"]))
        if os.path.commonpath([repo["path"], workdir]) != repo["path"]:
            raise RuntimeError("Working directory escapes the paired checkout.")
        if not os.path.isdir(workdir):
            raise RuntimeError("Working directory is missing on the cluster: " + workdir)
        command = ["sbatch", "--parsable"] + data["arguments"]
        if data["dry_run"]:
            answer = {"cwd": workdir, "command": command, "env": data["env"]}
        else:
            env = dict(os.environ, **data["env"])
            result = run(command, cwd=workdir, env=env)
            if not re.fullmatch(r"[0-9]+(?:;[^\s;]+)?", result):
                raise RuntimeError("sbatch returned no recognizable job ID; check the queue before retrying: " + result)
            job = result.split(";", 1)[0]
            answer = {"job": job, "cwd": workdir}
            try:
                answer["info"] = job_info(job)
            except (OSError, RuntimeError) as error:
                sys.stderr.write("Job " + job + " was submitted, but log lookup failed: " + str(error) + "\n")
    else:
        raise RuntimeError("Unknown remote operation.")
    print(json.dumps(answer))
except (OSError, RuntimeError, ValueError) as error:
    sys.stderr.write(str(error) + "\n")
    sys.exit(1)
'''


def validate_host(host):
    if not re.fullmatch(r"[A-Za-z0-9_@.\[\]:-]+", host) or host.startswith("-"):
        raise Error("Use an SSH alias or user@hostname; put ports and jump hosts in ~/.ssh/config.")
    return host


def remote(host, action, data):
    command = ["python3", "-c", REMOTE, action, json.dumps(data)]
    if host != "local":
        command = ["ssh", "--", host, shell_join(command)]
    result = subprocess.run(command, stdout=subprocess.PIPE, universal_newlines=True)
    if result.returncode:
        raise Error("Cluster operation failed; no automatic retry was attempted.")
    try:
        return json.loads(result.stdout)
    except ValueError:
        raise Error("Expected JSON from the cluster; check for shell startup messages on stdout.")


def selected_host(args, root=None):
    if args.local:
        return "local"
    return validate_host(args.host or (config(root, "cluster.host") if root else None) or "hendrix")


def cache_path(host, job):
    state = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state")))
    key = hashlib.sha256(host.encode()).hexdigest()[:16]
    return state / "cluster/jobs" / (key + "-" + job + ".json")


def save_job(host, job, info):
    path = cache_path(host, job)
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps({"host": host, "job": job, "info": info}) + "\n")
    except OSError as error:
        print("Job {}: could not save log paths: {}".format(job, error), file=sys.stderr)


def log_path(info, job, stderr=False):
    path = info.get("StdErr" if stderr else "StdOut")
    if not path or path in ("(null)", "/dev/null"):
        raise Error("This job has no {} log path.".format("stderr" if stderr else "stdout"))
    values = {"j": info.get("JobId", job.split("_")[0]),
              "A": info.get("ArrayJobId", job.split("_")[0]),
              "a": info.get("ArrayTaskId", job.split("_", 1)[1] if "_" in job else None),
              "x": info.get("JobName"), "u": info.get("UserId", "").split("(")[0], "%": "%"}

    def replace(match):
        width, key = match.groups()
        value = values.get(key)
        if value is None or not re.fullmatch(r"\d+", str(value)) and key == "a":
            raise Error("Choose an array task such as {}_0 to read its log.".format(job.split("_")[0]))
        return str(value).zfill(int(width or 0))

    path = re.sub(r"%([0-9]*)([%jAaxu])", replace, path)
    if re.search(r"%[0-9]*[A-Za-z]", path):
        raise Error("Node-specific log patterns are not supported: " + path)
    if not os.path.isabs(path):
        path = os.path.join(info.get("WorkDir", ""), path)
    if not os.path.isabs(path):
        raise Error("Slurm returned a relative log path without a working directory.")
    return path


def stream_logs(host, job, follow=False, stderr=False, lines=80):
    if not re.fullmatch(r"[0-9]+(?:_[0-9]+)?", job):
        raise Error("Use a numeric job ID, or an array task such as 12345_0.")
    try:
        cached = json.loads(cache_path(host, job).read_text())
        info = cached["info"]
    except (OSError, ValueError, KeyError):
        info = remote(host, "job", {"job": job})
        save_job(host, job, info)
    path = log_path(info, job, stderr)
    print("{}:{}{}".format(host, path, " (Ctrl+C stops following; the job keeps running)" if follow else ""), file=sys.stderr)
    command = ["tail", "-n", str(lines)] + (["-F"] if follow else []) + ["--", path]
    if host != "local":
        command = ["ssh", "--", host, "exec " + shell_join(command)]
    return subprocess.call(command)


def link(args):
    root = repo_root()
    host = validate_host(args.link_host)
    info = remote(host, "repo", {"path": args.path})
    if identity(git("remote", "get-url", "origin", cwd=str(root))) != identity(info["origin"]):
        raise Error("These checkouts have different Git origins; the pairing was not saved.")
    if not args.check:
        git("config", "--local", "cluster." + host + ".path", info["path"], cwd=str(root))
        git("config", "--local", "cluster.host", host, cwd=str(root))
    print("{} -> {}:{}{}".format(root, host, info["path"], " (check only)" if args.check else ""))
    return 0


def setup(args):
    local = args.local or args.setup_local
    if args.host and args.setup_host and args.host != args.setup_host:
        raise Error("Choose one setup host, using either --host or the setup argument.")
    host = args.setup_host or args.host
    if local and host:
        raise Error("Choose an SSH host or --local for setup.")
    if not local and not host:
        raise Error("Choose a target: cluster setup SSH_HOST, or cluster setup --local.")
    backend = Path(__file__).resolve().with_name("cluster-setup")
    if not backend.is_file():
        raise Error("The setup helper is missing. Update and restow the cluster package.")
    arguments = ["bash", str(backend)]
    if args.check:
        arguments.append("--check")
    if local:
        arguments.append("--local")
    if args.skip_plugins:
        arguments.append("--skip-plugins")
    if args.port is not None:
        if local:
            raise Error("An SSH port cannot be used with --local.")
        arguments.extend(["-p", str(args.port)])
    if host:
        arguments.append(validate_host(host))
    return subprocess.call(arguments)


def submit(args):
    root = repo_root()
    host = selected_host(args, root)
    arguments = args.arguments[1:] if args.arguments[:1] == ["--"] else args.arguments
    if not arguments:
        raise Error("Provide a batch script: cluster submit -- path/to/train.sbatch")
    if any(arg in ("-Q", "--quiet", "--quiet=yes") for arg in arguments):
        raise Error("Remove --quiet; the helper needs sbatch's job ID.")
    path = str(root) if host == "local" else config(root, "cluster." + host + ".path")
    if not path:
        raise Error("This checkout is not linked to {}.\nLink it once: cluster link {} REMOTE_CHECKOUT_PATH".format(host, shlex.quote(host)))
    if git("status", "--porcelain", "--untracked-files=no", cwd=str(root)):
        raise Error("Commit your local tracked changes, then push and pull on the cluster before submitting.")
    environment = {}
    for item in args.env:
        name, separator, value = item.partition("=")
        if not separator or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            raise Error("Use --env NAME=value for a job environment variable.")
        environment[name] = value
    answer = remote(host, "submit", {
        "path": path, "subdir": str(Path.cwd().resolve().relative_to(root)),
        "origin": identity(git("remote", "get-url", "origin", cwd=str(root))),
        "commit": git("rev-parse", "HEAD", cwd=str(root)),
        "arguments": arguments, "env": environment, "dry_run": args.dry_run,
    })
    if args.dry_run:
        command = (["env"] + [key + "=" + value for key, value in sorted(answer["env"].items())] if answer["env"] else []) + answer["command"]
        print("{}: cd {} && {}".format(host, shlex.quote(answer["cwd"]), shell_join(command)))
        print("Dry run: no job submitted.")
        return 0
    job = answer["job"]
    print("Submitted job {} on {} ({}).".format(job, host, answer["cwd"]), flush=True)
    if answer.get("info"):
        save_job(host, job, answer["info"])
    print("Logs: cluster {} logs {} --follow".format("--local" if host == "local" else "--host " + shlex.quote(host), job), flush=True)
    return stream_logs(host, job, follow=True) if args.follow else 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, epilog="Code sync stays in GitHub: commit/push locally and pull in the paired cluster checkout.")
    target = parser.add_mutually_exclusive_group()
    target.add_argument("-H", "--host", help="SSH alias; defaults to the repository pairing, then hendrix")
    target.add_argument("--local", action="store_true", help="run on this machine")
    commands = parser.add_subparsers(dest="command")
    installation = commands.add_parser("setup", help="check and install terminal tools and configurations")
    installation.add_argument("setup_host", metavar="SSH_HOST", nargs="?")
    installation.add_argument("--check", action="store_true", help="report available tools without changing the target")
    installation.add_argument("--local", dest="setup_local", action="store_true", help="set up this machine")
    installation.add_argument("--skip-plugins", action="store_true", help="skip tmux plugin downloads")
    installation.add_argument("-p", "--port", type=int, help="SSH port")
    pairing = commands.add_parser("link", help="pair this repository with an existing cluster checkout")
    pairing.add_argument("link_host", metavar="HOST")
    pairing.add_argument("path", help="absolute path, ~/path, or a path relative to the remote home")
    pairing.add_argument("--check", action="store_true", help="validate without saving the pairing")
    submission = commands.add_parser("submit", help="submit from the matching directory on the cluster")
    submission.add_argument("--dry-run", action="store_true", help="validate and print the submission without running sbatch")
    submission.add_argument("-f", "--follow", action="store_true", help="follow stdout after submission")
    submission.add_argument("--env", action="append", default=[], metavar="NAME=value")
    submission.add_argument("arguments", nargs=argparse.REMAINDER, metavar="SBATCH_ARGS", help="use -- before sbatch flags and the batch script")
    logs = commands.add_parser("logs", help="read a job's actual Slurm output file")
    logs.add_argument("job", help="job ID or array task ID")
    logs.add_argument("-f", "--follow", action="store_true")
    logs.add_argument("--stderr", action="store_true", help="read stderr instead of stdout")
    logs.add_argument("-n", "--lines", type=int, default=80)
    commands.add_parser("jobs", help="show your queued and running jobs")
    args = parser.parse_args(argv)
    if args.command == "setup":
        return setup(args)
    if args.command == "link":
        return link(args)
    if args.command == "submit":
        return submit(args)
    if args.command in ("logs", "jobs"):
        try:
            root = repo_root()
        except Error:
            root = None
        host = selected_host(args, root)
        if args.command == "logs":
            if args.lines < 0:
                raise Error("--lines must be zero or positive.")
            return stream_logs(host, args.job, args.follow, args.stderr, args.lines)
        command = 'exec squeue --user "$(id -un)" --format="%.18i %.14j %.10T %.10M %.10l %R"'
        return subprocess.call(["bash", "-c", command] if host == "local" else ["ssh", "--", host, command])
    parser.print_help()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (Error, OSError) as error:
        print("cluster: " + str(error), file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
