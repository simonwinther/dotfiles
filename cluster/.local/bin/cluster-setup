#!/bin/sh
set -eu
script="$(readlink -f -- "$0")"
local_root="$(dirname "$(dirname "$script")")"
binary="$local_root/share/cluster/bin/cluster-native"
if [ ! -x "$binary" ]; then
    binary="$(command -v cluster-native || true)"
    if [ -z "$binary" ]; then binary="${XDG_CACHE_HOME:-$HOME/.cache}/cluster/bin/cluster-native"; fi
fi
if [ ! -x "$binary" ]; then
    printf '%s\n' 'cluster: Run cluster-build to compile the Rust cluster tools.' >&2
    exit 1
fi
source_root="${CLUSTER_SOURCE_ROOT:-${DOTFILES:-$(cd "$(dirname "$script")/../../.." && pwd -P)}}"
exec "$binary" --source-root "$source_root" setup "$@"
