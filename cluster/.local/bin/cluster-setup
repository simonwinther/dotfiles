#!/usr/bin/env bash
# Copy the terminal packages to an SSH host, or install from a local checkout.
set -euo pipefail

usage() {
  cat <<'HELP'
Usage: cluster setup [--check] [-p PORT] SSH_HOST
       cluster setup --local [--check] [--skip-plugins]

  --check         Report available tools; do not change the target.
  --local         Set up the machine running this command.
  --skip-plugins  Leave tmux plugin downloads for a later run.
  -p PORT         SSH port (SSH config aliases and ProxyJump also work).
  -h, --help      Show this help.

Installs missing tools without sudo, backs up existing configurations, and
uses Stow to apply only Neovim, tmux, and this command. Run again to sync.
Neovim installs its plugins from lazy-lock.json on its first interactive start.
HELP
}

die() { printf 'cluster setup: %s\n' "$*" >&2; exit 1; }
log() { printf '\n%s\n' "$*"; }

# Quote for the remote login shell, which need not be Bash.
shell_quote() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

version_at_least() {
  local found=$1 minimum=$2 major minor patch
  [[ $found =~ ([0-9]+)\.([0-9]+)(\.([0-9]+))? ]] || return 1
  major=${BASH_REMATCH[1]}; minor=${BASH_REMATCH[2]}; patch=${BASH_REMATCH[4]:-0}
  local want_major want_minor want_patch
  IFS=. read -r want_major want_minor want_patch <<< "$minimum"
  (( major > want_major || (major == want_major && minor > want_minor) ||
     (major == want_major && minor == want_minor && patch >= ${want_patch:-0}) ))
}

check_only=false local_install=false skip_plugins=false host='' source_dir=''
ssh_options=()
while (($#)); do
  case $1 in
    --check) check_only=true ;;
    --local) local_install=true ;;
    --skip-plugins) skip_plugins=true ;;
    --source) (($# >= 2)) || die '--source needs a directory'; source_dir=$2; shift ;;
    -p) (($# >= 2)) || die '-p needs a port'; [[ $2 =~ ^[0-9]+$ ]] || die 'invalid SSH port'; ssh_options+=(-p "$2"); shift ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *) [[ -z $host ]] || die 'provide one SSH host at a time'; host=$1 ;;
  esac
  shift
done
if $local_install; then
  [[ -z $host && ${#ssh_options[@]} == 0 ]] || die '--local cannot take an SSH host or port'
else
  [[ -n $host ]] || { usage; exit 1; }
  [[ -z $source_dir ]] || die '--source requires --local'
fi

script=
[[ -z ${BASH_SOURCE[0]:-} ]] || script=$(readlink -f -- "${BASH_SOURCE[0]}")
if ! $local_install; then
  command -v ssh >/dev/null || die 'ssh is required on this machine'
  if $check_only; then
    # No remote temporary files or downloads for a check.
    ssh "${ssh_options[@]}" -- "$host" 'bash -s -- --local --check' < "$script"
    exit $?
  fi
  repo=$(cd -- "$(dirname -- "$script")/../../.." && pwd)
  [[ -f $repo/nvim/.config/nvim/init.lua && -f $repo/tmux/.tmux.conf ]] || die 'run from the dotfiles checkout on your PC'
  bundle=$(mktemp -d)
  trap 'rm -rf -- "$bundle"' EXIT
  # Only tracked editor/multiplexer files; no caches, credentials, or desktop packages.
  git -C "$repo" ls-files -z -- nvim tmux > "$bundle/files"
  printf '%s\0' 'cluster/.local/bin/cluster-setup' > "$bundle/command"
  [[ ! -f $repo/cluster/.local/bin/cluster ]] || printf '%s\0' 'cluster/.local/bin/cluster' >> "$bundle/command"
  tar -C "$repo" --null -T "$bundle/files" -T "$bundle/command" -cf "$bundle/payload.tar"
  if command -v infocmp >/dev/null; then
    : > "$bundle/terminal.info"
    for terminal in "${TERM:-xterm-256color}" tmux-256color; do
      infocmp -x -- "$terminal" >> "$bundle/terminal.info" 2>/dev/null || true
    done
    tar -C "$bundle" -rf "$bundle/payload.tar" terminal.info
  fi
  # shellcheck disable=SC2016
  remote='set -euo pipefail
umask 077
state="${CLUSTER_SETUP_HOME:-$HOME}/.local/share/cluster-setup"
mkdir -p -- "$state"
incoming=$(mktemp -d "$state/incoming.XXXXXX")
trap '\''rm -rf -- "$incoming"'\'' EXIT
tar -xf - -C "$incoming"
bash "$incoming/cluster/.local/bin/cluster-setup" --local --source "$incoming"'
  $skip_plugins && remote+=' --skip-plugins'
  ssh "${ssh_options[@]}" -- "$host" "bash -c $(shell_quote "$remote")" < "$bundle/payload.tar"
  exit $?
fi

# CLUSTER_SETUP_HOME also allows checks and installation tests in a scratch tree.
target_home=${CLUSTER_SETUP_HOME:-$HOME}
[[ $target_home == /* ]] || die 'the target home must be an absolute path'
state="$target_home/.local/share/cluster-setup"
prefix="$state/env"
packages="$state/dotfiles"
export PATH="$target_home/.local/bin:$PATH"
missing=() wrappers=()
old_tmux_server=false

check_tmux_server() {
  $old_tmux_server && return 0
  local response
  # Explicitly inspect the default socket, even when setup runs inside tmux.
  response=$(LC_ALL=C tmux -L default list-sessions 2>&1) || true
  case $response in
    *'server version is too old for client'*|*'protocol version mismatch'*)
      old_tmux_server=true
      printf '  %-14s %s\n' 'tmux server' 'incompatible older server on the default socket; existing sessions kept running'
      ;;
  esac
}

check_tool() {
  local command=$1 package=$2 minimum=${3:-} flag=${4:---version} output
  if output=$("$command" "$flag" 2>/dev/null) &&
     { [[ -z $minimum ]] || version_at_least "$output" "$minimum"; }; then
    printf '  %-14s %s\n' "$command" "${output%%$'\n'*}"
  else
    printf '  %-14s %s\n' "$command" "missing or too old${minimum:+ (need >= $minimum)}"
    missing+=("$package")
    wrappers+=("$command")
  fi
}

log "Checking tools on $(hostname) ($(uname -sm))"
check_tool nvim 'nvim>=0.12.0' 0.12.0
tmux_version=$(tmux -V 2>/dev/null || true)
if version_at_least "$tmux_version" 3.2; then
  printf '  %-14s %s\n' tmux "$tmux_version"
  check_tmux_server
else
  printf '  %-14s %s\n' tmux 'missing or too old (need >= 3.2)'
  missing+=('tmux>=3.2'); wrappers+=(tmux)
fi
check_tool git 'git>=2.19' 2.19
check_tool rg ripgrep
check_tool fd fd-find
check_tool fzf 'fzf>=0.25' 0.25
check_tool tree-sitter 'tree-sitter-cli>=0.26.1' 0.26.1
check_tool curl curl
check_tool unzip unzip '' -v
check_tool python3 'python>=3.6' 3.6

need_stow=false
if stow --version >/dev/null 2>&1; then
  printf '  %-14s %s\n' stow "$(command -v stow)"
elif [[ -x $state/stow/bin/stow ]]; then
  export PATH="$state/stow/bin:$PATH"
  printf '  %-14s %s\n' stow "$state/stow/bin/stow"
else
  printf '  %-14s %s\n' stow 'missing (will install GNU Stow)'
  need_stow=true
  command -v perl >/dev/null || { missing+=(perl); wrappers+=(perl); }
  command -v make >/dev/null || { missing+=(make); wrappers+=(make); }
fi
compiler=
for candidate in cc gcc clang; do
  if "$candidate" --version >/dev/null 2>&1; then compiler=$candidate; break; fi
done
if [[ -n $compiler ]]; then
  printf '  %-14s %s\n' 'C compiler' "$(command -v "$compiler")"
else
  printf '  %-14s %s\n' 'C compiler' 'missing (will install for Treesitter)'
  missing+=(c-compiler)
fi

if $check_only; then
  printf '\nCheck complete. No files changed.\n'
  exit 0
fi
[[ $(uname -s) == Linux ]] || die 'installation currently supports Linux'
[[ -z ${XDG_CONFIG_HOME:-} || $XDG_CONFIG_HOME == "$target_home/.config" ]] || die 'this Stow layout requires XDG_CONFIG_HOME to be unset or ~/.config'
[[ -n $source_dir ]] || source_dir=$(cd -- "$(dirname -- "$script")/../../.." && pwd)
source_dir=$(cd -- "$source_dir" && pwd -P)
[[ -f $source_dir/nvim/.config/nvim/init.lua && -f $source_dir/tmux/.tmux.conf &&
   -f $source_dir/cluster/.local/bin/cluster-setup ]] || die 'the source must include the nvim, tmux, and cluster packages'
# Backing up children through a directory symlink could move files in its source.
for parent in .config .local .local/bin .config/tmux; do
  [[ ! -L $target_home/$parent ]] || die "make ~/$parent a real directory before setup (it is currently a symlink)"
done
umask 077
mkdir -p -- "$state"
work=$(mktemp -d "$state/work.XXXXXX")
stamp=$(date +%Y%m%d-%H%M%S)-$$
backup="$state/backups/$stamp"
moved_paths=() copied_packages=()
stow_applied=false
cleanup() {
  local status=$? relative package
  if ((status != 0)) && ! $stow_applied; then
    for package in "${copied_packages[@]}"; do
      rm -rf -- "${packages:?}/${package:?}"
      [[ ! -d $backup/previous-source/$package ]] ||
        mv -- "$backup/previous-source/$package" "$packages/$package"
    done
    for relative in "${moved_paths[@]}"; do
      if [[ ! -e $target_home/$relative && ! -L $target_home/$relative ]]; then
        mv -- "$backup/$relative" "$target_home/$relative"
      fi
    done
    printf 'Setup failed before linking; original configurations restored.\n' >&2
  fi
  rm -rf -- "$work"
}
trap cleanup EXIT

fetch() {
  if command -v curl >/dev/null; then
    curl -fLsS --retry 2 --connect-timeout 20 --max-time 300 -o "$2" "$1"
  elif command -v wget >/dev/null; then
    wget -q --timeout=30 --tries=3 -O "$2" "$1"
  else
    die 'curl or wget is needed to bootstrap downloads; load a module providing one'
  fi
}

if ((${#missing[@]})); then
  case $(uname -m) in
    x86_64) platform=linux-64 ;;
    aarch64|arm64) platform=linux-aarch64 ;;
    *) die 'automatic tool installation supports Linux x86_64 and ARM64' ;;
  esac
  if [[ ! -x $state/micromamba ]]; then
    log 'Downloading micromamba for a private tools environment'
    fetch "https://micro.mamba.pm/api/micromamba/$platform/latest" "$work/micromamba.tar.bz2"
    tar -xjf "$work/micromamba.tar.bz2" -C "$work" bin/micromamba
    install -m755 "$work/bin/micromamba" "$state/micromamba"
  fi
  log "Installing missing tools: ${missing[*]}"
  action=create
  [[ ! -d $prefix/conda-meta ]] || action=install
  "$state/micromamba" --no-rc "$action" -y -r "$state/mamba" -p "$prefix" \
    --override-channels -c conda-forge --strict-channel-priority "${missing[@]}"
fi

# All generated launchers stay in the private state tree, never in the repo.
tool_bin="$packages/cluster-tools/.local/bin"
mkdir -p -- "$tool_bin"
write_wrapper() {
  local name=$1 executable=$2
  {
    printf '#!/usr/bin/env bash\nexec '
    printf '%q ' "$executable"
    printf '"$@"\n'
  } > "$work/launcher"
  chmod 755 "$work/launcher"
  mv -- "$work/launcher" "$tool_bin/$name"
}
for command in "${wrappers[@]}"; do
  [[ -x $prefix/bin/$command ]] || die "installation did not provide $command"
  write_wrapper "$command" "$prefix/bin/$command"
done
if [[ -z $compiler ]]; then
  compilers=("$prefix"/bin/*-conda-linux-gnu-cc)
  [[ -x ${compilers[0]} ]] || die 'installation did not provide a C compiler'
  write_wrapper cc "${compilers[0]}"
fi
# During setup, use the private bin directory before the launchers are stowed.
export PATH="$tool_bin:$prefix/bin:$PATH"
check_tmux_server

if $need_stow; then
  log 'Installing GNU Stow under your home directory'
  fetch https://ftp.gnu.org/gnu/stow/stow-2.4.1.tar.gz "$work/stow.tar.gz"
  tar -xzf "$work/stow.tar.gz" -C "$work"
  (cd "$work/stow-2.4.1"; ./configure --prefix="$state/stow" > "$work/stow-build.log" 2>&1 &&
    make >> "$work/stow-build.log" 2>&1 && make install >> "$work/stow-build.log" 2>&1) || {
      cat "$work/stow-build.log" >&2; die 'GNU Stow installation failed';
    }
  export PATH="$state/stow/bin:$PATH"
fi
[[ ! -x $state/stow/bin/stow ]] || write_wrapper stow "$state/stow/bin/stow"

backup_path() {
  local relative=$1 path="$target_home/$1" resolved
  [[ -e $path || -L $path ]] || return 0
  resolved=$(readlink -f -- "$path" || true)
  # Leave links already owned by this installation for Stow to restow.
  [[ $resolved != "$packages/"* ]] || return 0
  mkdir -p -- "$backup/$(dirname -- "$relative")"
  mv -- "$path" "$backup/$relative"
  moved_paths+=("$relative")
  printf '  Backed up %s\n' "$path"
}

log 'Applying the Neovim and tmux configurations with Stow'
for package in nvim tmux cluster; do
  if [[ $source_dir != "$packages" ]]; then
    [[ ! -d $packages/$package ]] || {
      mkdir -p -- "$backup/previous-source"
      mv -- "$packages/$package" "$backup/previous-source/$package"
    }
    copied_packages+=("$package")
    mkdir -p -- "$packages/$package"
    cp -a -- "$source_dir/$package/." "$packages/$package/"
  fi
done
backup_path .config/nvim
backup_path .tmux.conf
backup_path .tmux.conf.custom
# tmux prefers this XDG file over ~/.tmux.conf when both exist.
backup_path .config/tmux/tmux.conf
while IFS= read -r -d '' file; do
  backup_path ".local/bin/$(basename -- "$file")"
done < <(find "$tool_bin" "$packages/cluster/.local/bin" -maxdepth 1 -type f -print0)
mkdir -p -- "$target_home/.config" "$target_home/.local/bin"
stow -n -v -d "$packages" -t "$target_home" nvim tmux cluster cluster-tools
stow -R -v -d "$packages" -t "$target_home" nvim tmux cluster cluster-tools
stow_applied=true
export PATH="$target_home/.local/bin:$PATH"

if [[ -s $source_dir/terminal.info ]] && command -v tic >/dev/null; then
  tic -x -o "$target_home/.terminfo" "$source_dir/terminal.info" ||
    printf 'Could not install terminal definitions; use TERM=xterm-256color if needed.\n' >&2
fi

if ! $skip_plugins; then
  log 'Installing the tmux plugins declared in your config'
  mkdir -p -- "$target_home/.tmux/plugins"
  while read -r plugin; do
    [[ $plugin =~ ^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$ ]] || die "unsupported tmux plugin: $plugin"
    destination="$target_home/.tmux/plugins/${plugin##*/}"
    if [[ ! -d $destination ]]; then
      GIT_TERMINAL_PROMPT=0 git clone --depth 1 "https://github.com/$plugin.git" "$work/plugin"
      mv -- "$work/plugin" "$destination"
    fi
  done < <(awk '/^[[:space:]]*set(-option)? +-g +@plugin/ { gsub(/[\047\042]/, ""); print $4 }' "$packages/tmux/.tmux.conf")
fi

# Expose only ~/.local/bin; never activate the tools environment in ML shells.
# shellcheck disable=SC2016
path_line='case "$PATH" in "$HOME/.local/bin"|"$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac # cluster-setup'
for rc in .bashrc .profile .zshrc; do
  rc_path="$target_home/$rc"
  if ! grep -Fq '# cluster-setup' "$rc_path" 2>/dev/null; then
    if [[ -f $rc_path ]]; then
      mkdir -p -- "$backup"
      cp -p -- "$rc_path" "$backup/$rc"
    fi
    printf '\n%s\n' "$path_line" >> "$rc_path"
  fi
done
# Bash login shells use the first existing file of these, ahead of .profile.
for rc in .bash_profile .bash_login; do
  [[ ! -f $target_home/$rc ]] || {
    if ! grep -Fq '# cluster-setup' "$target_home/$rc"; then
      mkdir -p -- "$backup"
      cp -p -- "$target_home/$rc" "$backup/$rc"
      printf '\n%s\n' "$path_line" >> "$target_home/$rc"
    fi
    break
  }
done

log 'Ready. Reconnect, then run tmux or nvim.'
if $old_tmux_server; then
  printf 'An older tmux server is still running. Start a separate server with:\n'
  printf '  tmux -L cluster new-session -A -s main\n'
fi
# shellcheck disable=SC2016
printf 'For this shell: export PATH="$HOME/.local/bin:$PATH"\n'
printf 'Neovim installs plugins on first launch; Copilot needs its own login.\n'
[[ ! -d $backup ]] || printf 'Backups: %s\n' "$backup"
