#!/usr/bin/env bash
set -euo pipefail
script="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="$(cd "$(dirname "$script")/../../.." && pwd -P)"
helper="$repo_root/bin/.local/share/dotfiles/rust-build.sh"
if [[ ! -f "$helper" ]]; then
  helper="$(dirname "$(dirname "$script")")/share/cluster/rust-build.sh"
fi
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../../bin/.local/share/dotfiles/rust-build.sh
source "$helper"
source_root="$(dirname "$(dirname "$script")")/share/cluster"
rust_build_init cluster "$script" "$@"
host_target="$(rustc -vV | sed -n 's/^host: //p')"
target="${CLUSTER_BUILD_TARGET:-$host_target}"
if [[ "$build_check" == true && "$target" != "$host_target" ]]; then
  printf 'cluster-build: Run --check on the target architecture.\n' >&2
  exit 2
fi
export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-C target-feature=+crt-static"
rust_build_checks --target "$target"
rust_build_cargo build --release --target "$target" --bin cluster-native
binary="$CARGO_TARGET_DIR/$target/release/cluster-native"
program_headers="$(LC_ALL=C readelf -l "$binary")"
dynamic_entries="$(LC_ALL=C readelf -d "$binary")"
if grep -q 'INTERP' <<< "$program_headers" || grep -q '(NEEDED)' <<< "$dynamic_entries"; then
  printf 'cluster-build: Build has a dynamic loader; a static Linux build is required.\n' >&2
  exit 1
fi
if [[ "$build_check" == true ]]; then
  PYTHONDONTWRITEBYTECODE=1 CLUSTER_TEST_BINARY="$binary" CLUSTER_SOURCE_ROOT="$repo_root" \
    nice -n 10 python3 -m unittest discover -s "$repo_root/cluster/tests" -v
fi
destination="$cache_root/bin/cluster-native"
if [[ "$target" != "$host_target" ]]; then destination="$destination-$target"; fi
rust_build_publish "$binary" "$destination"
printf 'Rust cluster tools installed in %s/bin\n' "$cache_root"
