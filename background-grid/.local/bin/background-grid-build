#!/usr/bin/env bash
set -euo pipefail
script="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="$(cd "$(dirname "$script")/../../.." && pwd -P)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../../bin/.local/share/dotfiles/rust-build.sh
source "$repo_root/bin/.local/share/dotfiles/rust-build.sh"
source_root="$(dirname "$(dirname "$script")")/share/background-grid"
rust_build_init background-grid "$script" "$@"
rust_build_checks
rust_build_cargo build --release --bin background-grid-native
rust_build_publish "$CARGO_TARGET_DIR/release/background-grid-native" "$cache_root/bin/background-grid-native"
printf 'Rust wallpaper picker installed in %s/bin\n' "$cache_root"
