#!/usr/bin/env bash
set -euo pipefail
script="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="$(cd "$(dirname "$script")/../../.." && pwd -P)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../../bin/.local/share/dotfiles/rust-build.sh
source "$repo_root/bin/.local/share/dotfiles/rust-build.sh"
rust_build_init desktop-transcode "$script" "$@"
# --check was consumed by rust_build_init; this function takes Cargo options.
# shellcheck disable=SC2119
rust_build_checks
rust_build_cargo build --release --bin desktop-transcode-native
rust_build_publish "$CARGO_TARGET_DIR/release/desktop-transcode-native" "$cache_root/bin/desktop-transcode-native"
printf 'Rust transcoder installed in %s/bin\n' "$cache_root"
