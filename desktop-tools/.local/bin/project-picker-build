#!/usr/bin/env bash
set -euo pipefail

source_root="${XDG_DATA_HOME:-$HOME/.local/share}/desktop-tools/project-picker-tui"
cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/project-picker"
mkdir -p "$cache_root/build" "$cache_root/bin"
cp "$source_root/Cargo.toml" "$source_root/Cargo.lock" "$cache_root/build/"
cp -R "$source_root/src" "$cache_root/build/"
export CARGO_TARGET_DIR="$cache_root/target"
cargo build --locked --release --manifest-path "$cache_root/build/Cargo.toml"
install -m 755 "$CARGO_TARGET_DIR/release/project-picker-tui" "$cache_root/bin/project-picker-tui.new"
mv -f "$cache_root/bin/project-picker-tui.new" "$cache_root/bin/project-picker-tui"
