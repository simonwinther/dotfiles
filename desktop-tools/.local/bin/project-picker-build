#!/usr/bin/env bash
set -euo pipefail
script="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="$(cd "$(dirname "$script")/../../.." && pwd -P)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../../bin/.local/share/dotfiles/rust-build.sh
source "$repo_root/bin/.local/share/dotfiles/rust-build.sh"
source_root="$(dirname "$(dirname "$script")")/share/desktop-tools/project-picker-tui"
rust_build_init project-picker "$script" "$@"
rust_build_checks
rust_build_cargo build --release --bins
for binary in project-picker-core project-picker-tui; do
    rust_build_publish "$CARGO_TARGET_DIR/release/$binary" "$cache_root/bin/$binary"
done
printf 'Rust project picker installed in %s/bin\n' "$cache_root"
