#!/usr/bin/env bash
set -euo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
appearance=dark

# Match Neovim's Desktop appearance detection, including embedded terminals.
# Read on every invocation so future diff renders follow theme changes.
if [[ -f "${XDG_STATE_HOME:-$HOME/.local/state}/desktop/theme/light.mode" ]]; then
  appearance=light
fi

exec delta --config "$config_home/lazygit/delta.gitconfig" \
  --features "$appearance" "--$appearance" "$@"
